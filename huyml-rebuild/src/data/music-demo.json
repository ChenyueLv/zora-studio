  "lyrics": [
    {
      "time": 12.2,
      "text": "揉皱的纸"
    },
    {
      "time": 15.36,
      "text": "轻轻摊平"
    },
    {
      "time": 18.94,
      "text": "像我一样"
    },
    {
      "time": 26.02,
      "text": "我的画被笑过"
    },
    {
      "time": 28.5,
      "text": "我把头低下去"
    },
