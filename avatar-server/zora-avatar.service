[Unit]
Description=Zora avatar (小Z) realtime voice relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ray/zora-studio/avatar-server
EnvironmentFile=/home/ubuntu/ray/zora-avatar.env
ExecStart=/home/ubuntu/ray/zora-avatar-venv/bin/python /home/ubuntu/ray/zora-studio/avatar-server/server.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
